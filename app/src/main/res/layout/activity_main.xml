<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_vert_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="417dp"
        android:layout_height="91dp"
        android:background="#EF6C00"
        android:fontFamily="monospace"
        android:text="D. Sarge's Color Crawl"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold"
        android:typeface="normal"
        app:layout_constraintBottom_toTopOf="@+id/tv_main_red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_main_red"
        android:layout_width="404dp"
        android:layout_height="56dp"
        android:fontFamily="monospace"
        android:text="Red:"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/sb_main_red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <SeekBar
        android:id="@+id/sb_main_red"
        android:layout_width="342dp"
        android:layout_height="49dp"
        android:max="255"
        app:layout_constraintBottom_toTopOf="@+id/tv_main_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_main_red" />

    <TextView
        android:id="@+id/tv_main_green"
        android:layout_width="406dp"
        android:layout_height="52dp"
        android:fontFamily="monospace"
        android:text="Green:"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/sb_main_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sb_main_red" />

    <SeekBar
        android:id="@+id/sb_main_green"
        android:layout_width="350dp"
        android:layout_height="34dp"
        android:layout_marginBottom="30dp"
        android:max="255"
        app:layout_constraintBottom_toTopOf="@+id/sb_main_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_main_green" />

    <TextView
        android:id="@+id/tv_main_blue"
        android:layout_width="412dp"
        android:layout_height="53dp"
        android:layout_marginBottom="7dp"
        android:fontFamily="monospace"
        android:text="Blue:"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/sb_main_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sb_main_green" />

    <SeekBar
        android:id="@+id/sb_main_blue"
        android:layout_width="362dp"
        android:layout_height="34dp"
        android:max="255"
        app:layout_constraintBottom_toTopOf="@+id/tv_main_hex"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.593"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sb_main_green" />

    <TextView
        android:id="@+id/tv_main_hex"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="Hex Code:"
        android:textAlignment="center"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/btn_main_save"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sb_main_blue" />

    <Button
        android:id="@+id/btn_main_save"
        android:layout_width="342dp"
        android:layout_height="60dp"
        android:layout_marginStart="70dp"
        android:layout_marginEnd="70dp"
        android:backgroundTint="#EF6C00"
        android:capitalize="none"
        android:text="Save Color"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColorLink="#CA1414"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/lv_main_colors"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_main_hex" />

    <ListView
        android:id="@+id/lv_main_colors"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_main_save" />

</androidx.constraintlayout.widget.ConstraintLayout>